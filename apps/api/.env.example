NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://devflow:devflow@localhost:5433/devflow
REDIS_URL=redis://localhost:6379

# Identity & Access (Wave 1) — GitHub App used for login only (see
# apps/api/docs/wave-1-identity-tenancy.md §3.1). Register a GitHub App with
# no repo/org permissions, Account permissions > Email addresses: Read-only,
# webhook "Active" unchecked, callback URL matching GITHUB_OAUTH_CALLBACK_URL.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback
WEB_APP_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_SECRET=
SESSION_TTL_DAYS=30
SESSION_REFRESH_THRESHOLD_DAYS=7
OAUTH_STATE_TTL_MINUTES=10

# Integration Layer (Wave 2) — encrypts per-org provider credentials at rest
# (AES-256-GCM, @devflow/integrations-core). Must be exactly 32 bytes, base64-encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_CREDENTIALS_KEY=

# Integration Layer (Wave 2) — GitHub App, org-wide install (SourceControl),
# separate from Wave 1's login-only App. Register at
# https://github.com/settings/apps/new with permissions: Contents (branches),
# Pull requests (read/write), Checks (read/write), Issue comments (read/write);
# webhook Active, subscribed to pull_request, pull_request_review, check_run,
# issue_comment.
GITHUB_APP_ID=
# Base64 of the App's downloaded PEM private key: node -e "console.log(require('fs').readFileSync('key.pem').toString('base64'))"
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# Integration Layer (Wave 2) — Slack app (Chat). Register at
# https://api.slack.com/apps with bot scopes chat:write, channels:read,
# groups:read; Signing Secret is under Basic Info (app-wide, not per-install).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_OAUTH_CALLBACK_URL=http://localhost:4000/api/v1/integrations/slack/callback
